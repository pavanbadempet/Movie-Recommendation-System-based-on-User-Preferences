# ==============================================================================
# APEX RECOMMENDATION SYSTEM: SERVERLESS LOCAL DEVELOPMENT ENV VARS
# Copy this file to '.env' and fill in the values below.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLOUD VECTOR DATABASE (NEON)
# ------------------------------------------------------------------------------
# Grab this from your Neon.tech Dashboard. 
# Databricks exports the vectors here, and FastAPI reads them.
DATABASE_URL=postgresql://nova_user:password@ep-cool-db-12345.us-east-2.aws.neon.tech/apex_db?sslmode=require

# ------------------------------------------------------------------------------
# 2. GENERATIVE AI (RAG EXPLANATIONS)
# ------------------------------------------------------------------------------
# Used by backend/intelligence/llm_explanations.py for personalized recommendations
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxx
TMDB_API_KEY=your_tmdb_api_key_here

# ------------------------------------------------------------------------------
# 3. ZEROBUS STREAMING INGEST (DATABRICKS AUTO LOADER)
# ------------------------------------------------------------------------------
# Where should the Cloudflare Worker/FastAPI send live user clicks?
DATABRICKS_ZEROBUS_URL=https://community.cloud.databricks.com/api/2.0/streaming/ingest/zerobus
DATABRICKS_TOKEN=dapi_your_personal_access_token_here

# ------------------------------------------------------------------------------
# 4. LOCAL CACHE (REDIS)
# ------------------------------------------------------------------------------
# Used for Contextual Bandits and LLM Cache. 
# Handled automatically by docker-compose if running locally.
REDIS_URL=redis://redis:6379/0

# ------------------------------------------------------------------------------
# 5. SECURITY & ADMIN
# ------------------------------------------------------------------------------
# Secret key for JWT Token generation (run `openssl rand -hex 32` to generate)
JWT_SECRET_KEY=super-secret-local-dev-key
NOVA_ADMIN_TOKEN=admin-secret-token
