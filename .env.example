# TMDB API Key (Required for fetching posters and details)
TMDB_API_KEY=your_tmdb_api_key_here

# Backend API URL (For Streamlit Frontend)
API_URL=http://localhost:8000

# Default product/customer context for local demos
NOVA_TENANT_ID=demo-media-co
NOVA_CATALOG_ID=tmdb-movies

# Optional product API auth.
# Backend accepts NOVA_API_KEYS as JSON or CSV:
# NOVA_API_KEYS=secret-key:demo-media-co:tmdb-movies:free
# Streamlit sends NOVA_API_KEY as X-Nova-API-Key when set.
NOVA_API_KEY=
NOVA_API_KEYS=

# Optional local behavior event log path
EVENT_LOG_PATH=data/events/movie_events.jsonl
NOVA_EVENT_STORE=jsonl
NOVA_EVENT_DATABASE_URL=
NOVA_EVENT_TABLE=nova_content_events
NOVA_EVENT_READ_LIMIT=100000
NOVA_USAGE_PATH=data/events/api_usage.jsonl
NOVA_CATALOG_UPLOAD_PATH=data/customer_catalogs
NOVA_EXPERIMENT_NAME=nova_personalization_v2
NOVA_EXPERIMENT_VARIANTS=control:50,personalized_v2:50
NOVA_EXPERIMENT_SALT=nova

# Optional AI quality switches.
# Keep false on tiny free tiers; enable when the model cache/runtime can handle it.
NOVA_ENABLE_DENSE_QUERY=false
NOVA_QUERY_ENCODER_MODEL=all-mpnet-base-v2
NOVA_ENABLE_CROSS_ENCODER=false
NOVA_CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
NOVA_RERANK_WINDOW=30
NOVA_TFIDF_MAX_FEATURES=50000
NOVA_INCLUDE_ADULT_CONTENT=false

# Optional learned ranker artifact. Create it with:
# python scripts/train_ranker.py
NOVA_RANKER_PATH=models/nova_ranker.joblib
NOVA_RANKER_URL=https://huggingface.co/pavanbadempet/movie-recs-models/resolve/main/nova_ranker.joblib
NOVA_RANKER_METADATA_URL=https://huggingface.co/pavanbadempet/movie-recs-models/resolve/main/nova_ranker.joblib.metadata.json
