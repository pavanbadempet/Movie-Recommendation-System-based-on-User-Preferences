# TMDB API Key (Required for fetching posters and details)
TMDB_API_KEY=your_tmdb_api_key_here

# Backend API URL (For Streamlit Frontend)
API_URL=http://localhost:8000

# Default product/customer context for local demos
NOVA_TENANT_ID=demo-media-co
NOVA_CATALOG_ID=tmdb-movies

# Optional product API auth.
# Backend accepts NOVA_API_KEYS as JSON or CSV:
# NOVA_API_KEYS=secret-key:demo-media-co:tmdb-movies:free
# Streamlit sends NOVA_API_KEY as X-Nova-API-Key when set.
NOVA_API_KEY=
NOVA_API_KEYS=

# Server-to-server operations only. Set the same value in GitHub Actions and
# the deployed backend to let the daily artifact workflow reload serving state.
NOVA_ADMIN_TOKEN=

# Optional local behavior event log path
EVENT_LOG_PATH=data/events/movie_events.jsonl
NOVA_EVENT_STORE=jsonl
NOVA_EVENT_DATABASE_URL=
NOVA_EVENT_TABLE=nova_content_events
NOVA_EVENT_READ_LIMIT=100000
NOVA_USAGE_PATH=data/events/api_usage.jsonl
NOVA_CATALOG_UPLOAD_PATH=data/customer_catalogs
NOVA_EXPERIMENT_NAME=nova_personalization_v2
NOVA_EXPERIMENT_VARIANTS=control:50,personalized_v2:50
NOVA_EXPERIMENT_SALT=nova

# Optional AI quality switches.
# Keep false on tiny free tiers; enable when the model cache/runtime can handle it.
NOVA_ENABLE_DENSE_QUERY=false
NOVA_QUERY_ENCODER_MODEL=all-mpnet-base-v2
NOVA_ENABLE_CROSS_ENCODER=false
NOVA_CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
NOVA_RERANK_WINDOW=30
NOVA_TFIDF_MAX_FEATURES=50000
NOVA_ITEM_TFIDF_MAX_FEATURES=40000
NOVA_INCLUDE_ADULT_CONTENT=false
NOVA_ENABLE_LEARNED_RANKER=auto
NOVA_MIN_RANKER_FEEDBACK_ITEMS=100
NOVA_ALLOW_LEGACY_ROW_ALIGNED_VECTORS=false
NOVA_REFRESH_PIPELINE_MANIFEST=false
NOVA_SERVING_PROFILE=auto
NOVA_LOW_MEMORY=false
NOVA_HEALTH_LOAD_RECOMMENDER=false
NOVA_BACKGROUND_RECOMMENDER_WARMUP=false
NOVA_ASYNC_EVALUATION_CACHE=false
NOVA_PRECOMPUTE_SEMANTIC_BENCHMARK=false
NOVA_SEMANTIC_BENCHMARK_CACHE_TTL_SECONDS=3600
PIPELINE_MANIFEST_URL=https://huggingface.co/pavanbadempet/movie-recs-models/resolve/main/pipeline_manifest.json
MOVIE_IDS_URL=https://huggingface.co/pavanbadempet/movie-recs-models/resolve/main/movie_ids.npy

# Optional OpenRouter features.
# Chat can use OpenRouter when OPENROUTER_API_KEY is set. LLM reranking stays
# off by default because free models are often rate-limited and should not
# block recommendation serving.
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODELS=google/gemma-3-27b-it:free,qwen/qwen3-next-80b-a3b-instruct:free,meta-llama/llama-3.3-70b-instruct:free,openai/gpt-oss-20b:free
OPENROUTER_CHAT_TIMEOUT_SECONDS=10
NOVA_ENABLE_LLM_RERANK=false
OPENROUTER_RERANK_MODELS=google/gemma-3-27b-it:free,qwen/qwen3-next-80b-a3b-instruct:free,meta-llama/llama-3.3-70b-instruct:free,openai/gpt-oss-20b:free
OPENROUTER_RERANK_TIMEOUT_SECONDS=8
NOVA_LLM_RERANK_CANDIDATES=12

# Optional: make this backend a lightweight gateway and let a Hugging Face
# Space own vector-heavy search/recommendation serving.
NOVA_RECOMMENDER_SERVICE_URL=
NOVA_RECOMMENDER_SERVICE_API_KEY=
NOVA_RECOMMENDER_SERVICE_TIMEOUT_SECONDS=12

# Optional learned ranker artifact. Create it with:
# python scripts/train_ranker.py
NOVA_RANKER_PATH=models/nova_ranker.joblib
NOVA_RANKER_URL=https://huggingface.co/pavanbadempet/movie-recs-models/resolve/main/nova_ranker.joblib
NOVA_RANKER_METADATA_URL=https://huggingface.co/pavanbadempet/movie-recs-models/resolve/main/nova_ranker.joblib.metadata.json
