{
  "title": "APEX Recommendation Engine — Overview",
  "uid": "apex-overview",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Request Rate (req/s)",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(rate(nova_http_requests_total[1m]))",
          "legendFormat": "req/s"
        }
      ],
      "options": { "colorMode": "background", "graphMode": "area" }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Error Rate (%)",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "100 * sum(rate(nova_http_requests_total{http_status=~\"5..\"}[5m])) / sum(rate(nova_http_requests_total[5m]))",
          "legendFormat": "error %"
        }
      ],
      "options": {
        "colorMode": "background",
        "thresholds": {
          "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 1 },
            { "color": "red", "value": 3 }
          ]
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Recommendation p95 Latency (ms)",
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.95, sum(rate(nova_http_request_duration_seconds_bucket{endpoint=~\"/v1/recommendations.*\"}[5m])) by (le)) * 1000",
          "legendFormat": "p95 ms"
        }
      ],
      "options": {
        "colorMode": "background",
        "thresholds": {
          "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 10000 },
            { "color": "red", "value": 25000 }
          ]
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Search p95 Latency (ms)",
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 4 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.95, sum(rate(nova_http_request_duration_seconds_bucket{endpoint=~\"/v1/search.*\"}[5m])) by (le)) * 1000",
          "legendFormat": "p95 ms"
        }
      ],
      "options": {
        "colorMode": "background",
        "thresholds": {
          "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 1500 },
            { "color": "red", "value": 2500 }
          ]
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "HTTP Request Rate by Endpoint",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum by (endpoint) (rate(nova_http_requests_total[1m]))",
          "legendFormat": "{{endpoint}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Error Rate by Endpoint (%)",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "100 * sum by (endpoint) (rate(nova_http_requests_total{http_status=~\"5..\"}[5m])) / sum by (endpoint) (rate(nova_http_requests_total[5m]))",
          "legendFormat": "{{endpoint}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Request Duration Percentiles — Recommendations",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.50, sum(rate(nova_http_request_duration_seconds_bucket{endpoint=~\"/v1/recommendations.*\"}[5m])) by (le)) * 1000",
          "legendFormat": "p50"
        },
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.95, sum(rate(nova_http_request_duration_seconds_bucket{endpoint=~\"/v1/recommendations.*\"}[5m])) by (le)) * 1000",
          "legendFormat": "p95"
        },
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.99, sum(rate(nova_http_request_duration_seconds_bucket{endpoint=~\"/v1/recommendations.*\"}[5m])) by (le)) * 1000",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Request Duration Percentiles — Search",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.50, sum(rate(nova_http_request_duration_seconds_bucket{endpoint=~\"/v1/search.*\"}[5m])) by (le)) * 1000",
          "legendFormat": "p50"
        },
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.95, sum(rate(nova_http_request_duration_seconds_bucket{endpoint=~\"/v1/search.*\"}[5m])) by (le)) * 1000",
          "legendFormat": "p95"
        },
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.99, sum(rate(nova_http_request_duration_seconds_bucket{endpoint=~\"/v1/search.*\"}[5m])) by (le)) * 1000",
          "legendFormat": "p99"
        }
      ]
    }
  ]
}
