{
  "name": "raw_events",
  "version": 1,
  "description": "Canonical raw movie interaction event contract for downstream ingestion.",
  "primary_key": ["event_id"],
  "partition_keys": ["event_date"],
  "required_columns": ["event_id", "event_ts", "event_type", "event_date"],
  "columns": {
    "event_id": {
      "type": "string",
      "nullable": false
    },
    "event_ts": {
      "type": "datetime",
      "nullable": false
    },
    "event_type": {
      "type": "string",
      "nullable": false,
      "enum": ["view", "click", "search", "rating", "favorite"]
    },
    "movie_id": {
      "type": "integer",
      "nullable": true
    },
    "user_id": {
      "type": "string",
      "nullable": true
    },
    "rating": {
      "type": "number",
      "nullable": true,
      "min": 0.0,
      "max": 5.0
    },
    "query_text": {
      "type": "string",
      "nullable": true
    },
    "event_date": {
      "type": "string",
      "nullable": false
    }
  }
}
