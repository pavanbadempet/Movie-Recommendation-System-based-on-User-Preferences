# Movie Recommendation System - Git Ignore

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
.venv_cuda/
venv/
ENV/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Environment variables
.env
frontend/.env

# Data files (too large for git)
data/raw/*.csv
data/raw/*.zip
data/raw/ml-latest-small/
data/raw/ml-25m/
data/datalake/
data/events/*.jsonl
data/events/*.dlq
data/processed/*.parquet
data/processed/*_summary.json

# Runtime event logs and processed data inside backend package
backend/data/events/*.jsonl
backend/data/processed/*.parquet
backend/data/processed/*.json

# Local runtime state and temporary artifacts
.hadoop/
*.sqlite3            # covers nova_db.sqlite3 and any other local DBs
*.sqlite3-*
*.bak
benchmark_temp.json
movies_temp.parquet

# Generated revision / build metadata
REVISION

# Frontend coverage reports (generated by Vitest — not source)
frontend/coverage/

# Incremental dev scripts (never commit work-in-progress versions)
scripts/_slim_recommender*.py
scripts/_verify_arch.py

# Frontend build logs
frontend-vite*.log
frontend-vite*.err.log

# Model artifacts (hosted on HuggingFace, NOT in GitHub)
# Kaggle generates -> Hugging Face stores -> Render downloads at runtime
models/*.index
models/*.npy
models/*.joblib
models/*.joblib.metadata.json
models/*.pth
models/*.gpickle
models/onnx/
models/pipeline_manifest.json

# Backend-local model artifact copies (same files, duplicated into package)
backend/models/*.index
backend/models/*.npy
backend/models/*.joblib
backend/models/*.joblib.metadata.json
backend/models/*.pth
backend/models/*.gpickle
backend/models/pipeline_manifest.json
backend/artifacts/*.pt
backend/artifacts/*.pth

# Keep directory structure
!data/raw/.gitkeep
!data/processed/.gitkeep
!models/.gitkeep
!backend/models/.gitkeep
!backend/artifacts/.gitkeep
!backend/data/events/.gitkeep
!backend/data/processed/.gitkeep

# Logs
logs/*.log
*.log
reports/

# OS files
.DS_Store
Thumbs.db

# Pickle files (old format, deprecated)
*.pkl

# Jupyter notebooks checkpoints
.ipynb_checkpoints/

# Distribution
dist/
build/
*.egg-info/
frontend/node_modules/
frontend/dist/
frontend/.env.local
frontend/*.tsbuildinfo

# Temp debug scripts
analyze_features.py
test_punctuation_fix.py
test_recs.py
test_output.txt
verify.log
test_llm.py
test_recommendations.py
test_delta_implementation.py
final_verification.py
verify_implementation.py

# Personal files (don't push to public repo)
resume*.tex
docs/INTERVIEW_GUIDE.md
docs/INTERVIEW_AND_PRODUCT_PLAYBOOK.md
