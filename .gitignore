# Movie Recommendation System - Git Ignore

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
.venv_cuda/
venv/
ENV/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Environment variables
.env

# Data files (too large for git)
data/raw/*.csv
data/raw/*.zip
data/processed/*.parquet

# Model artifacts (hosted on HuggingFace, NOT in GitHub)
# Kaggle generates → HuggingFace stores → Render downloads at runtime
models/*.index
models/*.npy
models/*.joblib
models/*.joblib.metadata.json
models/pipeline_manifest.json

# Keep directory structure
!data/raw/.gitkeep
!data/processed/.gitkeep
!models/.gitkeep

# Logs
logs/*.log
*.log

# OS files
.DS_Store
Thumbs.db

# Pickle files (old format, deprecated)
*.pkl

# Jupyter notebooks checkpoints
.ipynb_checkpoints/

# Distribution
dist/
build/
*.egg-info/

# Temp debug scripts
analyze_features.py
test_punctuation_fix.py
test_recs.py
test_output.txt
verify.log

# Personal files (don't push to public repo)
resume*.tex
docs/INTERVIEW_GUIDE.md
